{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aero Dock",
  "version": "1.3.2-zh.1",
  "identifier": "com.aerodock.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "dock",
        "title": "Aero Dock",
        "width": 1200,
        "height": 220,
        "transparent": true,
        "decorations": false,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "shadow": false,
        "visible": false,
        "acceptFirstMouse": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-gpu"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "linyuYL",
    "copyright": "Copyright (c) 2026 Ryan Panda",
    "category": "Utility",
    "shortDescription": "Simplified Chinese application dock for Windows",
    "longDescription": "Aero Dock Simplified Chinese fork with an application-only dock, item import, custom icons, window previews and desktop visibility fixes. Based on Aero Dock by Ryan Panda and distributed under the MIT license.",
    "homepage": "https://github.com/linyuYL/aero-dock",
    "license": "MIT",
    "resources": {
      "../LICENSE": "LICENSE"
    },
    "licenseFile": "../LICENSE"
  }
}
